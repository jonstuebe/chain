{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chain",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The Vite plugin fills in assets.directory with the client build output.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The big dictionary (data/dictionary.txt). Wrangler creates it on first deploy
  // and writes its id back here; load the rows with `npm run seed-words`.
  "d1_databases": [
    { "binding": "WORDS", "database_name": "chain-words", "migrations_dir": "migrations" }
  ],
  "routes": [
    { "pattern": "chain.jonstuebe.com", "custom_domain": true }
  ]
}
