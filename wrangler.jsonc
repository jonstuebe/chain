{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chain",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The Vite plugin fills in assets.directory with the client build output.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The big dictionary (data/dictionary.txt). Load or reload its rows with
  // `npm run seed-words -- --remote`.
  "d1_databases": [
    { "binding": "WORDS", "database_name": "chain-words", "database_id": "85eaf661-540e-4be0-942a-fea5dba08566", "migrations_dir": "migrations" }
  ],
  "routes": [
    { "pattern": "chain.jonstuebe.com", "custom_domain": true }
  ]
}
